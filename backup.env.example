# Shared configuration for the source code backup and restore scripts.
#
# Copy to backup.env (same directory as the scripts) and adjust:
#   cp backup.env.example backup.env
#   chmod 600 backup.env
#
# Settings for each source live in sources/<name>/source.env.
#
# Use absolute paths. The restore step runs under sudo, where $HOME
# may point to /root.
# Override the location with BACKUP_ENV_FILE=/path/to/file if needed.

# --- Staging and logs ---
BACKUP_DIR="/home/iannegishi/OJT/backup-lab/forgejo-backups"ssssssss
LOCK_FILE="/tmp/source-code-backup.lock"        
LOG_DIR="/home/iannegishi/OJT/source-code-backup-logs"
SOURCES="forgejo"

# --- Restore ---
RESTORE_DIR="/home/backupuser/source-code-restic-restore"   # restic restores snapshots here

# --- Restic ---
RESTIC_REPOSITORY="/home/backupuser/source-code-restic-repo"
RESTIC_PASSWORD_FILE="/home/backupuser/.source-code-restic-pass"
RESTIC_KEEP_DAILY="7"
RESTIC_KEEP_WEEKLY="5"                          # with daily 7: about one month of history
RESTIC_CHECK_SUBSETS="7"                        # read 1/N of the data per run; full coverage every N days

# --- Rclone (offsite copy to S3) ---
# S3 credentials with write access live in rclone_writer.env.
. /home/backupuser/source-code-backup/rclone_writer.env
RCLONE_CONFIG_S3BACKUP_TYPE="s3"
RCLONE_CONFIG_S3BACKUP_PROVIDER="AWS"
RCLONE_CONFIG_S3BACKUP_REGION="ap-northeast-1"
RCLONE_CONFIG_S3BACKUP_NO_CHECK_BUCKET="true"
RCLONE_REMOTE="S3BACKUP:<bucket-name>/restic-repo"
