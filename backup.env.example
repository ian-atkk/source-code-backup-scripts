# Configuration for the Forgejo backup and restore scripts.
#
# Copy to backup.env (same directory as the scripts) and adjust:
#   cp backup.env.example backup.env
#   chmod 600 backup.env
#
# Use absolute paths. The restore step runs under sudo, where $HOME
# may point to /root.
# Override the location with BACKUP_ENV_FILE=/path/to/file if needed.

# --- Forgejo ---
FORGEJO_DIR="/home/backupuser/forgejo"          # directory containing compose.yaml
FORGEJO_SERVICE="server"                        # service name in compose.yaml
FORGEJO_CONTAINER="forgejo"                     # container_name in compose.yaml
FORGEJO_UID="1000"
FORGEJO_GID="1000"
FORGEJO_IMAGE="codeberg.org/forgejo/forgejo:15" # image used by the recovery instance

# --- Staging and logs ---
BACKUP_DIR="/home/backupuser/forgejo-backups"   # dumps are written here, then backed up by restic
STATE_FILE="/tmp/forgejo-backup-cycle.state"
LOCK_FILE="/tmp/forgejo-backup-cycle.lock"
LOG_DIR="/home/backupuser/source-code-backup-logs"

# --- Restic ---
RESTIC_REPOSITORY="/home/backupuser/forgejo-restic-repo"
RESTIC_PASSWORD_FILE="/home/backupuser/.forgejo-restic-pass"
RESTIC_KEEP_DAILY="7"
RESTIC_KEEP_WEEKLY="46"
RESTIC_CHECK_SUBSETS="7"                        # read 1/N of the data per run; full coverage every N days

# --- Restore ---
RESTORE_DIR="/home/backupuser/forgejo-restic-restore"
RECOVERY_DIR="/home/backupuser/forgejo-recovery"
RECOVERY_CONTAINER="forgejo-recovery"
RECOVERY_PORT="4001"
