# Forgejo settings for the source code backup scripts.
#
# Copy to source.env (same directory) and adjust:
#   cp source.env.example source.env
#   chmod 600 source.env

# --- Gitlab ---
GITLAB_DIR="/home/backupuser/gitlab
GITLAB_SERVICE="server"
GITLAB_CONTAINER="gitlab"
GITLAB_UID="1000"
GITLAB_GIC="1000"
GITLAB_IMAGE="gitlab/gitlab-ce:18.10.1-ce.0"


# --- Restore ---
RESTORE_DIR="/home/backupuser/gitlab-restore"
RECOVERY_DIR="/home/backupuser/gitlab-recovery"
RECOVERY_CONTAINER="gitlab-recovery"
RECOVERY_PORT="4001"
