# Restore-from-S3 configuration: reads the offsite copy with read-only keys.
#
# Copy to backup.restore-s3.env and adjust, then run:
#   BACKUP_ENV_FILE=/path/to/backup.restore-s3.env ./source-code-restore-cycle.sh <snapshot-id>

# --- Logs and snapshot path ---
LOG_DIR="/home/backupuser/source-code-backup-logs"
BACKUP_DIR="/home/backupuser/backup-staging"    # must match BACKUP_DIR in backup.env (path inside the snapshot)

# --- Restic (read-only, from S3) ---
# S3 credentials with read-only access live in restic_reader.env.
. /home/backupuser/source-code-backup/restic_reader.env
RESTIC_REPOSITORY="s3:s3.ap-northeast-1.amazonaws.com/<bucket-name>/restic-repo"
RESTIC_PASSWORD_FILE="/home/backupuser/.source-code-restic-pass"

# --- Restore ---
RESTORE_DIR="/home/backupuser/source-code-restic-restore"
